bundle common site_classes
{
  classes:
    "is_lxc"
      expression => returnszero(
        "/usr/bin/systemd-detect-virt --quiet --container=lxc"
      );

    "is_docker"
      expression => returnszero(
        "/usr/bin/systemd-detect-virt --quiet --container=docker"
      );

    "is_container" or => { "is_lxc", "is_docker" };
}
