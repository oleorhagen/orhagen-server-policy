body file control
{
  inputs => {
    "services/roles/common.cf",
    "services/roles/k3s_server.cf",
    "services/roles/database.cf",
    "services/roles/fileserver.cf",
    "services/roles/cfengine_hub.cf",
  };
}

bundle agent roles
{
  meta:
    "tags" slist => { "autorun" };

  methods:
    "common"  usebundle => role_common;

    orhagen_no_server::
      "k3s"   usebundle => role_k3s_server;

    postgresql_server_turnkey::
      "db"    usebundle => role_database;

    fileserver_turnkey::
      "files" usebundle => role_fileserver;

    cfengine_hub::
      "hub"   usebundle => role_cfengine_hub;
}
