bundle agent role_k3s_server
{
  packages:
    "open-iscsi"
      policy => "present";

  files:
    "/etc/sysctl.d/99-k3s.conf"
      create  => "true",
      content => "net.ipv4.ip_forward=1
net.bridge.bridge-nf-call-iptables=1
net.bridge.bridge-nf-call-ip6tables=1
",
      classes => if_repaired("reload_sysctl");

  commands:
    reload_sysctl::
      "/sbin/sysctl --system"
        contain => in_shell;
}
